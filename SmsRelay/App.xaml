<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SmsRelay.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Primary">#1D4ED8</Color>
      <Style TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{StaticResource Primary}" /><Setter Property="CornerRadius" Value="22" /><Setter Property="HeightRequest" Value="44" /><Setter Property="WidthRequest" Value="44" /><Setter Property="Padding" Value="0" /></Style>
      <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F2F7, Dark=#000000}" /></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
